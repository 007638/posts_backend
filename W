package main
import (
  "fmt"
  "github.com/gin-gonic/gin"
  "html/template"
  "net/http"
  "gorm.io/driver/mysql"
  "gorm.io/gorm"
  "github.com/gin-contrib/sessions"
  "github.com/gin-contrib/sessions/cookie"
  "path/filepath"
  "os"
  "io"
)

type Article struct {
  ID uint
  Title string
  Context string
  IsShow bool `gorm:"default:true"`
}
type User struct {
  ID uint `gorm:"primaryKey"`
  Username string `gorm:"unique"`
  Password string
  IsAdmin  bool `gorm:"default:true"`
}

func main() {
  dsn := "root:daydayUP888@tcp(127.0.0.1:3306)/blog?charset=utf8mb4&parseTime=true&loc=Local"
  db,err := gorm.Open(mysql.Open(dsn),&gorm.Config{})//使用gorm连接数据库
  if err != nil {
    panic("数据库连接失败")
  }
  //自动更新表结构
  db.AutoMigrate(&Article{},&User{})
  store := cookie.NewStore([]byte("blog123456"))//创建一个加密仓库，存登录状态
  store.Options(sessions.Options{
    MaxAge: 86400,
    Path: "/",
  })
  router :=gin.Default()
  router.MaxMultipartMemory = 10 << 20
  router.Use(sessions.Sessions("mysession", store))//让整个网站都能识别"谁登陆了，谁没登录"

  os.MkdirAll("./static/upload", 0755)//创建upload文件夹

  router.SetFuncMap(template.FuncMap{
    "safeHTML": func(str string) template.HTML {
        return template.HTML(str)
    },
})
router.LoadHTMLGlob("templates/*.tmpl")
  router.Static("/static", "./static")
//登录页面
  router.GET("/login", func(c *gin.Context) {
    c.HTML(http.StatusOK, "login.tmpl", gin.H{} )
})

  //登录提交
router.POST("/do_login", func(c *gin.Context) {
  //对比用户名和密码
  username := c.PostForm("username")
  password := c.PostForm("password")

  //如果验证通过,就设置session
  var user User
  db.Where("username=?", username).First(&user)
  fmt.Println("user is:", user)

    if user.ID != 0 && user.Password == password {
     session := sessions.Default(c)
     session.Set("username", user.Username)
     session.Save()

     c.Redirect(302,"/")
}else{
   c.Redirect(302, "/login")
}
})
 //退出登录
router.GET("/do_logout", func(c *gin.Context) {
  session := sessions.Default(c)
  session.Clear()//清除登录状态
  session.Save()//保存清除后的结果
  c.Redirect(302,"/")//退出后跳会首页
  })


  router.GET("/ping", func(c *gin.Context) {
    c.JSON(200, gin.H{
      "message": "pong",
    })
  })

  router.GET("/", func(c *gin.Context){
    searchTitle := c.Query("searchTitle") // 搜标题
    searchContext := c.Query("searchContext")

    var articles []Article
    dbQuery := db.Where("is_show = ?", true)//定义db.Query变量

    // 只搜标题
    if searchTitle != "" {
      dbQuery = dbQuery.Where("title LIKE ?", "%"+searchTitle+"%")
    }
    if searchContext != "" {
      dbQuery = dbQuery.Where("context LIKE ?", "%"+searchContext+"%")
    }
    //执行查询
    dbQuery.Find(&articles)

    //读取服务器上最新的图片
   var imgUrl string
   files, _ := filepath.Glob("./static/upload/*")
   if len(files) > 0 {
     imgUrl = "/static/upload/" + filepath.Base(files[len(files)-1])
   }

   session := sessions.Default(c)
		username := session.Get("username")

    c.HTML(http.StatusOK,"index.tmpl",gin.H{
      "title":"我是璇起的个人博客",
      "articles":articles,
      "username":username,
      "imgUrl":imgUrl,//把图片传给前端
    })
  })

  //增加图片上传接口
  router.POST("/upload", func(c *gin.Context) {
    file, err := c.FormFile("file")
    if err != nil {
      c.String(400,"上传失败")
      return
    }
    //上传新图前，自动删掉旧的头像，保证永远显示最新的
    oldFiles, _ := filepath.Glob("./static/upload/*")
    for _, f := range oldFiles {
      os.Remove(f)
    }
   //保存到服务器static/upload目录
    savePath := "./static/upload/" + file.Filename
    //打开上传的文件
    src, err := file.Open()
    if err != nil {
      c.String(400, "打开文件失败")
      return
    }
    defer src.Close()
     //创建目标文件
    dst, err := os.Create(savePath)
    if err != nil {
      c.String(400, "创建文件失败")
      return
    }
    defer dst.Close()
    io.Copy(dst, src)
  //上传成功回到首页
  c.Redirect(302,"/")
})

  router.GET("/new", func(c *gin.Context){ //添加新建列表的路由
    c.HTML(http.StatusOK, "new.tmpl", gin.H{})
  })

  router.POST("/create",func(c *gin.Context){ //创建/create,用来把/new页面提交的数据，保存到数据库
    //先获得请求中的参数
    title := c.PostForm("title")
    context := c.PostForm("context")
    isShow := c.PostForm("IsShow") == "on"
    //在保存到数据库中
    db.Create(&Article{Title: title, Context: context, IsShow: isShow})

    //跳转到列表页
    c.Redirect(http.StatusMovedPermanently,"/")
  })

  //专门查未显示在首页的文章路由
  router.GET("/hidden",func(c *gin.Context) {
    username := c.DefaultQuery("username", "")
    var articles []Article
    db.Where("is_show = ?", false).Find(&articles)

    c.HTML(http.StatusOK,"hidden.tmpl",gin.H{
      "title": "我的隐藏博客",
      "username": username,
      "articles": articles,
    })
  })

  //添加删除的路由
  router.GET("/delete",func(c *gin.Context){
   db.Delete(&Article{}, c.Query("id"))
    //跳转到列表页
    c.Redirect(http.StatusMovedPermanently,"/")
  })
  //添加编辑路由
  router.GET("/edit", func(c *gin.Context){
     var article Article
    db.First(&article, c.Query("id"))
    c.HTML(http.StatusOK, "edit.tmpl", gin.H{
      "article": article,
    })
  })

  //添加更新路由
  router.POST("/update",func(c *gin.Context){
    //先获得请求中的参数
    id := c.PostForm("id")
    title := c.PostForm("title")
    context := c.PostForm("context")
    isShow := c.PostForm("IsShow") == "on"

    var article Article
    db.First(&article, id)
    article.Title = title
    article.Context = context
    article.IsShow = isShow
    db.Save(&article)
    //跳转到列表页面
    c.Redirect(http.StatusMovedPermanently,"/")
  })

  //添加查看路由
  router.GET("/show", func(c *gin.Context){
     var article Article
    db.First(&article, c.Query("id"))
    c.HTML(http.StatusOK, "show.tmpl", gin.H{
      "article": article,
    })
  })

  router.Run("0.0.0.0:8081")
}

